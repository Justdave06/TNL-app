# Copy to `.env` and adjust for your environment.
#
# The app reuses the existing Nuxt backend (my-business-web). Point this at a
# reachable host:
#
#   - Android emulator uses http://10.0.2.2:3000 automatically (host loopback).
#   - iOS simulator can use http://localhost:3000.
#   - Physical devices need the HTTPS tunnel URL of the Nuxt app, e.g.
#     npm run tunnel in my-business-web -> use that URL here.
#
# Note: Expo inlines EXPO_PUBLIC_* variables at build time, so restart
# `expo start` with `--clear` after changing this file.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000