{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    /**
     * Installable APK for testing on real phones.
     *
     * EXPO_PUBLIC_API_URL is inlined at build time, so it must point somewhere
     * the phone can reach. It currently uses the trycloudflare quick-tunnel URL
     * (npm run tunnel) — NOTE: a quick tunnel gets a NEW URL every time it is
     * restarted, so if the tunnel restarts you must update this value and
     * rebuild. For same-network-only testing you can swap in your PC's IP,
     * e.g. http://<pc-ip>:3000.
     */
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sheep-improving-pizza-titles.trycloudflare.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
