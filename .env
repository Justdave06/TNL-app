# Copy to `.env` and adjust for your environment.
#
# The app talks to Supabase directly (no Express server). Set these
# variables from your Supabase project dashboard (Settings → API).
#
# Note: Expo inlines EXPO_PUBLIC_* variables at build time, so restart
# `expo start` with `--clear` after changing this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
