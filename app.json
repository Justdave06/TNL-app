{
  "expo": {
    "name": "The Noodle Line",
    "slug": "tnl-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tnlapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0a09",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "The Noodle Line uses the camera to scan QR codes on loyalty and membership cards.",
        "NSPhotoLibraryAddUsageDescription": "Save your digital TNL card image to your photo library."
      }
    },
    "android": {
      "package": "com.davejohn06.tnlapp",
      "adaptiveIcon": {
        "backgroundColor": "#0c0a09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0a09",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0c0a09"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The Noodle Line uses the camera to scan QR codes on loyalty and membership cards.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow The Noodle Line to save your digital TNL card to your photo library.",
          "savePhotosPermission": "Allow The Noodle Line to save your digital TNL card to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "793bd039-3323-4ab9-914a-8492d4a72b60"
      }
    },
    "owner": "davejohn06"
  }
}
